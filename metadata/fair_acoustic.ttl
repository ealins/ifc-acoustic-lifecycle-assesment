@prefix fairac: <https://example.org/fair-acoustic/vocab/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .

fairac: a owl:Ontology ;
    dct:title "FAIR Acoustic Component Platform vocabulary" ;
    dct:description "Minimal research vocabulary linking FAIR acoustic packages, IFC geometry, measurement datasets and lifecycle stewardship." .

fairac:FairAcousticPackage a owl:Class ; rdfs:label "FAIR Acoustic Package" .
fairac:IFCGeometry a owl:Class ; rdfs:label "IFC Geometry" .
fairac:hasGeometry a owl:ObjectProperty ; rdfs:domain fairac:FairAcousticPackage ; rdfs:range fairac:IFCGeometry .
fairac:hasMeasurement a owl:ObjectProperty ; rdfs:domain fairac:FairAcousticPackage .
fairac:stewardedBy a owl:ObjectProperty ; rdfs:domain fairac:FairAcousticPackage .
fairac:ifcGlobalId a owl:DatatypeProperty .
fairac:fairStatus a owl:DatatypeProperty .
fairac:lifecycleStatus a owl:DatatypeProperty .
