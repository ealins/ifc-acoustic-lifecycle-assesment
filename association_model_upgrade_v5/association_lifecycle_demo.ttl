    prov:endedAtTime "2026-08-19T00:20:00+02:00"^^xsd:dateTime ;
    prov:used <https://example.org/hft-acoustic/ifc/element/2qL6OSUnz6ZAzEOn1HxeD2/snapshot/bau1-2026-02-18>,
        <https://example.org/hft-acoustic/record/vabdat-310/snapshot/prototype-v2> ;
    prov:wasAssociatedWith <https://example.org/hft-acoustic/agent/thesis-workflow> ;
    map:trigger "external-resource-unavailable" .

<https://example.org/hft-acoustic/mapping/activity/2qL6OSUnz6ZAzEOn1HxeD2--vabdat-310-validation-r4> a map:ValidationActivity ;
    prov:endedAtTime "2026-08-19T00:30:00+02:00"^^xsd:dateTime ;
    prov:used <https://example.org/hft-acoustic/ifc/element/2qL6OSUnz6ZAzEOn1HxeD2/snapshot/bau1-2026-02-18>,
        <https://example.org/hft-acoustic/record/vabdat-310/snapshot/prototype-v2> ;
