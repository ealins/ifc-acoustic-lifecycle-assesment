PREFIX map: <https://example.org/hft-acoustic/mapping/vocab/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX prov: <http://www.w3.org/ns/prov#>

# Q1 — Current status of every governed IFC-to-acoustic association
SELECT ?series ?wall ?record ?status ?modelVersion ?recordVersion ?review ?rationale WHERE {
  ?series a map:MappingSeries ;
          map:ifcElement ?wall ;
          map:acousticRecord ?record ;
          map:currentAssertion ?assertion .
  ?assertion map:status ?statusConcept ;
             map:ifcModelVersion ?modelVersion ;
             map:recordVersion ?recordVersion ;
             map:requiresReview ?review ;
             map:rationale ?rationale .
  ?statusConcept skos:prefLabel ?status .
}

# Q2 — Associations that require review
SELECT ?wall ?record ?status ?rationale WHERE {
  ?series a map:MappingSeries ; map:currentAssertion ?assertion .
  ?assertion map:ifcElement ?wall ; map:acousticRecord ?record ;
             map:requiresReview true ; map:status ?statusConcept ; map:rationale ?rationale .
  ?statusConcept skos:prefLabel ?status .
}

# Q3 — Full revision history for an association
SELECT ?assertion ?status ?modelVersion ?recordVersion ?time ?previous WHERE {
  ?assertion a map:MappingAssertion ;
             map:ifcModelVersion ?modelVersion ;
             map:recordVersion ?recordVersion ;
             map:assessedAt ?time ;
             map:status ?statusConcept .
  ?statusConcept skos:prefLabel ?status .
  OPTIONAL { ?assertion prov:wasRevisionOf ?previous }
}
ORDER BY ?time

# Q4 — Validation provenance: which evidence snapshots generated each assertion?
SELECT ?assertion ?activity ?usedEvidence ?trigger WHERE {
  ?assertion a map:MappingAssertion ; prov:wasGeneratedBy ?activity .
  ?activity prov:used ?usedEvidence ; map:trigger ?trigger .
}
ORDER BY ?assertion ?usedEvidence
