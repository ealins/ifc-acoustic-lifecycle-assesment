@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix vibro: <https://w3id.org/vibro-ifc/vocab/> .

# Profile 0.1.0. Unknown facts should be explicit and explained in limitations.

vibro:MeasurementRecordShape a sh:NodeShape ;
  sh:targetClass vibro:VibrometryMeasurementRecord ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [ sh:path dct:conformsTo ; sh:hasValue "https://w3id.org/vibro-ifc/profile/0.1" ] ;
  sh:property [ sh:path vibro:profileVersion ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue "0.1.0" ] ;
  sh:property [ sh:path vibro:recordIdentifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ; sh:pattern "^[^\\\\/]+$" ] ;
  sh:property [ sh:path vibro:createdAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$" ] ;
  sh:property [ sh:path vibro:measurementPayload ; sh:minCount 1 ; sh:maxCount 1 ; sh:node vibro:MeasurementPayloadShape ] ;
  sh:property [ sh:path vibro:labContext ; sh:minCount 1 ; sh:maxCount 1 ; sh:node vibro:LabContextShape ] ;
  sh:property [ sh:path vibro:ifcLinkRecord ; sh:minCount 1 ; sh:maxCount 1 ; sh:node vibro:IfcLinkShape ] ;
  sh:sparql [
    sh:message "Any explicit unknown laboratory value must be explained in limitations." ;
    sh:select """
      PREFIX vibro: <https://w3id.org/vibro-ifc/vocab/>
      SELECT $this WHERE {
        $this vibro:labContext ?lab .
        ?lab ?field "unknown" .
        FILTER(?field IN (vibro:instrument, vibro:operator, vibro:calibrationStatus, vibro:scanSetup, vibro:processingDescription))
        FILTER NOT EXISTS {
          ?lab vibro:limitations ?limitations .
          FILTER(CONTAINS(LCASE(STR(?limitations)), "unknown"))
        }
      }
    """
  ] .

vibro:MeasurementPayloadShape a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [ sh:path vibro:fileName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[^\\\\/]+$" ] ;
  sh:property [ sh:path vibro:mediaType ; sh:minCount 1 ; sh:in ( "text/plain" "text/csv" ) ] ;
  sh:property [ sh:path vibro:byteSize ; sh:minCount 1 ; sh:datatype xsd:integer ; sh:minInclusive 1 ] ;
  sh:property [ sh:path vibro:sha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^sha256:[0-9a-f]{64}$" ] ;
  sh:sparql [
    sh:message "Payload filename extension and declared media type must agree (.csv/text/csv or .txt/text/plain)." ;
    sh:select """
      PREFIX vibro: <https://w3id.org/vibro-ifc/vocab/>
      SELECT $this WHERE {
        $this vibro:fileName ?name ; vibro:mediaType ?mediaType .
        FILTER(
          (STRENDS(LCASE(STR(?name)), ".csv") && STR(?mediaType) != "text/csv") ||
          (STRENDS(LCASE(STR(?name)), ".txt") && STR(?mediaType) != "text/plain") ||
          (!STRENDS(LCASE(STR(?name)), ".csv") && !STRENDS(LCASE(STR(?name)), ".txt"))
        )
      }
    """
  ] .

vibro:LabContextShape a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [ sh:path vibro:method ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path vibro:instrument ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path vibro:operator ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path vibro:measurementDate ; sh:minCount 1 ; sh:or (
    [ sh:hasValue "unknown" ]
    [ sh:pattern "^((?:[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])00))-02-29))$" ]
  ) ] ;
  sh:property [ sh:path vibro:calibrationStatus ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path vibro:scanSetup ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path vibro:measuredQuantity ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path vibro:unit ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path vibro:processingDescription ; sh:minCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path vibro:limitations ; sh:minCount 1 ; sh:datatype xsd:string ] .

vibro:IfcLinkShape a sh:NodeShape ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [ sh:path vibro:ifcFileName ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[^\\\\/]+\\.ifc$" ; sh:flags "i" ] ;
  sh:property [ sh:path vibro:ifcSha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^sha256:[0-9a-f]{64}$" ] ;
  sh:property [ sh:path vibro:ifcSchema ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^IFC[0-9A-Za-z_]*$" ] ;
  sh:property [ sh:path vibro:ifcGlobalId ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[0-3][0-9A-Za-z_$]{21}$" ] ;
  sh:property [ sh:path vibro:ifcEntityType ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^Ifc[A-Za-z0-9_]+$" ] ;
  sh:property [ sh:path vibro:componentName ; sh:maxCount 1 ; sh:datatype xsd:string ] .
