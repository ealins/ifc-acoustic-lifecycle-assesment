map:technicalResolution a rdf:Property ;
    rdfs:label "technical resolution" .

map:testArea_m2 a rdf:Property ;
    rdfs:label "test area (m2)" .

map:totalThickness_m a rdf:Property ;
    rdfs:label "total thickness (m)" .

map:trigger a rdf:Property ;
    rdfs:label "validation trigger" .

map:validationBasis a rdf:Property ;
    rdfs:label "validation basis" .

map:wallEvidenceJson a rdf:Property ;
    rdfs:label "wall evidence JSON" .

map:weightedSoundReductionIndex a rdf:Property ;
    rdfs:label "weighted sound reduction index" .

