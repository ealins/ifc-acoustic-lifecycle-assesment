@prefix dct: <http://purl.org/dc/terms/> .
@prefix map: <https://example.org/hft-acoustic/mapping/vocab/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix status: <https://example.org/hft-acoustic/mapping/status/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

map:AcousticRecordSnapshot a rdfs:Class ;
    rdfs:label "Acoustic record snapshot" ;
    rdfs:comment "Version-specific state of an acoustic record used by a mapping validation activity." ;
    rdfs:subClassOf prov:Entity .

map:ChangeEvent a rdfs:Class ;
    rdfs:label "Evidence change event" ;
    rdfs:comment "Field-level change recorded between successive mapping assertions." .

map:CorrespondenceStatus a rdfs:Class,
        skos:ConceptScheme ;
    rdfs:label "Correspondence status vocabulary" .

map:IFCElementSnapshot a rdfs:Class ;
    rdfs:label "IFC element snapshot" ;
    rdfs:comment "Version-specific evidence about an IFC element used by a mapping validation activity." ;
    rdfs:subClassOf prov:Entity .

map:MappingAssertion a rdfs:Class ;
    rdfs:label "Mapping assertion" ;
    rdfs:comment "Versioned assessment of the technical and semantic validity of one IFC-element to acoustic-record association." ;
    rdfs:subClassOf prov:Entity .

map:MappingSeries a rdfs:Class ;
    rdfs:label "Mapping series" ;
    rdfs:comment "Stable identity for the governed association between an IFC element and an external acoustic record across validation revisions." .

map:ValidationActivity a rdfs:Class ;
    rdfs:label "Mapping validation activity" ;
    rdfs:subClassOf prov:Activity .

<https://example.org/hft-acoustic/mapping/series/2qL6OSUnz6ZAzEOn1HxeD2--vabdat-310> a map:MappingSeries ;
    map:acousticRecord <https://example.org/hft-acoustic/record/vabdat-310> ;
    map:currentAssertion <https://example.org/hft-acoustic/mapping/assertion/2qL6OSUnz6ZAzEOn1HxeD2--vabdat-310-r2> ;
    map:ifcElement <https://example.org/hft-acoustic/ifc/element/2qL6OSUnz6ZAzEOn1HxeD2> .

status:ambiguous a skos:Concept ;
    skos:inScheme map:CorrespondenceStatus ;
    skos:prefLabel "AMBIGUOUS" .

status:broken a skos:Concept ;
    skos:inScheme map:CorrespondenceStatus ;
    skos:prefLabel "BROKEN" .

status:invalid a skos:Concept ;
    skos:inScheme map:CorrespondenceStatus ;
    skos:prefLabel "INVALID" .

status:multiple-candidates a skos:Concept ;
    skos:inScheme map:CorrespondenceStatus ;
    skos:prefLabel "MULTIPLE_CANDIDATES" .

status:unmatched a skos:Concept ;
    skos:inScheme map:CorrespondenceStatus ;
    skos:prefLabel "UNMATCHED" .

map:acousticRecord a rdf:Property ;
    rdfs:label "acoustic record" .

map:acousticUnit a rdf:Property ;
    rdfs:label "acoustic unit" .

map:assessedAt a rdf:Property ;
    rdfs:label "assessed at" .

map:changeCategory a rdf:Property ;
    rdfs:label "change category" .

map:changedField a rdf:Property ;
    rdfs:label "changed field" .

map:componentResource a rdf:Property ;
    rdfs:label "described component resource" .

map:constructionFamily a rdf:Property ;
    rdfs:label "construction family" .

map:currentAssertion a rdf:Property ;
    rdfs:label "current assertion" .

map:dataYear a rdf:Property ;
    rdfs:label "data year" .

map:evidenceHash a rdf:Property ;
    rdfs:label "evidence hash" .

map:evidenceModelVersion a rdf:Property ;
    rdfs:label "evidence model version" .

map:hasChange a rdf:Property ;
    rdfs:label "has change" .

map:hasLayerEvidence a rdf:Property ;
    rdfs:label "has layer evidence" .

map:ifcElement a rdf:Property ;
    rdfs:label "IFC element" .

map:ifcGlobalId a rdf:Property ;
    rdfs:label "IFC GlobalId" .

map:ifcModelVersion a rdf:Property ;
    rdfs:label "IFC model version" .

map:ifcReferenceLocation a rdf:Property ;
    rdfs:label "IFC reference Location URI" .

map:layerCategory a rdf:Property ;
    rdfs:label "layer category" .

map:layerName a rdf:Property ;
    rdfs:label "layer name" .

map:layerPosition a rdf:Property ;
    rdfs:label "layer position" .

map:layerThickness_m a rdf:Property ;
    rdfs:label "layer thickness (m)" .

map:linkCarrier a rdf:Property ;
    rdfs:label "IFC-side link carrier" .

map:materialEvidence a rdf:Property ;
    rdfs:label "material evidence" .

map:newValue a rdf:Property ;
    rdfs:label "new value" .

map:oldValue a rdf:Property ;
    rdfs:label "old value" .

map:previousStatus a rdf:Property ;
    rdfs:label "previous status" .

map:rationale a rdf:Property ;
    rdfs:label "mapping rationale" .

map:recordAssembly a rdf:Property ;
    rdfs:label "record assembly" .

map:recordConstructionFamily a rdf:Property ;
    rdfs:label "record construction family" .

map:recordEvidenceJson a rdf:Property ;
    rdfs:label "record evidence JSON" .

map:recordTotalThickness_m a rdf:Property ;
    rdfs:label "record total thickness (m)" .

map:recordVersion a rdf:Property ;
    rdfs:label "acoustic record version" .

map:requiresReview a rdf:Property ;
    rdfs:label "requires review" .

map:sourceGenerationActivity a rdf:Property ;
    rdfs:label "source generation activity" .

map:sourceNote a rdf:Property ;
    rdfs:label "source note" .

map:sourceOrganisation a rdf:Property ;
    rdfs:label "source organisation" .

