@prefix map: <https://example.org/hft-acoustic/mapping/vocab/> .
@prefix status: <https://example.org/hft-acoustic/mapping/status/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

map:MappingSeries a rdfs:Class ;
    rdfs:label "Mapping series" ;
    rdfs:comment "Stable identity for the governed association between an IFC element and an external acoustic record across validation revisions." .

map:MappingAssertion a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Mapping assertion" ;
    rdfs:comment "Versioned assessment of the technical and semantic validity of one IFC-element to acoustic-record association." .

map:ValidationActivity a rdfs:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Mapping validation activity" .

map:IFCElementSnapshot a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "IFC element snapshot" ;
    rdfs:comment "Version-specific evidence about an IFC element used by a mapping validation activity." .

map:AcousticRecordSnapshot a rdfs:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Acoustic record snapshot" ;
    rdfs:comment "Version-specific state of an acoustic record used by a mapping validation activity." .


map:ChangeEvent a rdfs:Class ;
    rdfs:label "Evidence change event" ;
    rdfs:comment "Field-level change recorded between successive mapping assertions." .

map:evidenceHash a rdf:Property ; rdfs:label "evidence hash" .
map:evidenceModelVersion a rdf:Property ; rdfs:label "evidence model version" .
map:wallEvidenceJson a rdf:Property ; rdfs:label "wall evidence JSON" .
map:recordEvidenceJson a rdf:Property ; rdfs:label "record evidence JSON" .
map:hasChange a rdf:Property ; rdfs:label "has change" .
map:changeCategory a rdf:Property ; rdfs:label "change category" .
map:changedField a rdf:Property ; rdfs:label "changed field" .
map:oldValue a rdf:Property ; rdfs:label "old value" .
map:newValue a rdf:Property ; rdfs:label "new value" .

map:CorrespondenceStatus a rdfs:Class, skos:ConceptScheme ;
    rdfs:label "Correspondence status vocabulary" .

map:ifcElement a rdf:Property ; rdfs:label "IFC element" .
map:acousticRecord a rdf:Property ; rdfs:label "acoustic record" .
map:currentAssertion a rdf:Property ; rdfs:label "current assertion" .
map:status a rdf:Property ; rdfs:label "mapping status" .
map:rationale a rdf:Property ; rdfs:label "mapping rationale" .
map:validationBasis a rdf:Property ; rdfs:label "validation basis" .
map:ifcGlobalId a rdf:Property ; rdfs:label "IFC GlobalId" .
map:ifcModelVersion a rdf:Property ; rdfs:label "IFC model version" .
map:recordVersion a rdf:Property ; rdfs:label "acoustic record version" .
map:technicalResolution a rdf:Property ; rdfs:label "technical resolution" .
map:requiresReview a rdf:Property ; rdfs:label "requires review" .
map:assessedAt a rdf:Property ; rdfs:label "assessed at" .
map:constructionFamily a rdf:Property ; rdfs:label "construction family" .
map:totalThickness_m a rdf:Property ; rdfs:label "total thickness (m)" .
map:materialEvidence a rdf:Property ; rdfs:label "material evidence" .
map:recordAssembly a rdf:Property ; rdfs:label "record assembly" .
map:recordConstructionFamily a rdf:Property ; rdfs:label "record construction family" .
map:recordTotalThickness_m a rdf:Property ; rdfs:label "record total thickness (m)" .
map:weightedSoundReductionIndex a rdf:Property ; rdfs:label "weighted sound reduction index" .
map:acousticUnit a rdf:Property ; rdfs:label "acoustic unit" .
map:testArea_m2 a rdf:Property ; rdfs:label "test area (m2)" .
map:surfaceMass_kg_m2 a rdf:Property ; rdfs:label "surface mass (kg/m2)" .
map:dataYear a rdf:Property ; rdfs:label "data year" .
map:sourceOrganisation a rdf:Property ; rdfs:label "source organisation" .
map:sourceReference a rdf:Property ; rdfs:label "source reference" .
map:sourceType a rdf:Property ; rdfs:label "source type" .
map:sourceNote a rdf:Property ; rdfs:label "source note" .
map:componentResource a rdf:Property ; rdfs:label "described component resource" .
map:sourceGenerationActivity a rdf:Property ; rdfs:label "source generation activity" .
map:hasLayerEvidence a rdf:Property ; rdfs:label "has layer evidence" .
map:layerPosition a rdf:Property ; rdfs:label "layer position" .
map:layerName a rdf:Property ; rdfs:label "layer name" .
map:layerCategory a rdf:Property ; rdfs:label "layer category" .
map:layerThickness_m a rdf:Property ; rdfs:label "layer thickness (m)" .
map:linkCarrier a rdf:Property ; rdfs:label "IFC-side link carrier" .
map:ifcReferenceLocation a rdf:Property ; rdfs:label "IFC reference Location URI" .
map:trigger a rdf:Property ; rdfs:label "validation trigger" .
map:previousStatus a rdf:Property ; rdfs:label "previous status" .

status:acceptable a skos:Concept ; skos:inScheme map:CorrespondenceStatus ; skos:prefLabel "ACCEPTABLE" .
status:ambiguous a skos:Concept ; skos:inScheme map:CorrespondenceStatus ; skos:prefLabel "AMBIGUOUS" .
status:invalid a skos:Concept ; skos:inScheme map:CorrespondenceStatus ; skos:prefLabel "INVALID" .
status:unmatched a skos:Concept ; skos:inScheme map:CorrespondenceStatus ; skos:prefLabel "UNMATCHED" .
status:multiple-candidates a skos:Concept ; skos:inScheme map:CorrespondenceStatus ; skos:prefLabel "MULTIPLE_CANDIDATES" .
status:broken a skos:Concept ; skos:inScheme map:CorrespondenceStatus ; skos:prefLabel "BROKEN" .
status:semantically-stale a skos:Concept ; skos:inScheme map:CorrespondenceStatus ; skos:prefLabel "SEMANTICALLY_STALE" .
